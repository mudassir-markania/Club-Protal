{
  "name": "club-portal",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev:frontend": "npm run dev -w @club-portal/frontend",
    "dev:backend": "npm run dev -w @club-portal/backend",
    "seed:admin": "npm run seed:admin -w @club-portal/backend",
    "seed:roster": "npm run seed:roster -w @club-portal/backend",
    "seed:scoring-rules": "npm run seed:scoring-rules -w @club-portal/backend"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
