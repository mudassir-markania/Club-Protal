generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, REFEREE
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  refereeId    String?   @unique
  referee      Referee?  @relation(fields: [refereeId], references: [id])
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
}

model Club {
  id                 String             @id @default(uuid())
  name               String             @unique
  code               String             @unique
  logoUrl            String?
  captainName        String?
  viceCaptainName    String?
  status             String             @default("ACTIVE") // ACTIVE, INACTIVE
  totalPoints        Int                @default(0)
  currentRank        Int                @default(0)
  players            Player[]
  matchParticipants  MatchParticipant[]
  pointsHistory      PointsHistory[]
  leaderboardEntries LeaderboardEntry[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Sport {
  id                 String             @id @default(uuid())
  name               String             @unique
  category           String             // OutDoor, Indoor, Racquet, Athletics
  icon               String?
  sportType          String             // INDIVIDUAL, TEAM, DOUBLES
  genderCategory     String             @default("OPEN") // MALE, FEMALE, MIXED, OPEN
  maxParticipants    Int                @default(11)
  tournamentFormat   String             @default("KNOCKOUT") // KNOCKOUT, LEAGUE, ROUND_ROBIN, GROUP_STAGE
  numRounds          Int                @default(3)
  scoringConfig      String             // JSON string: { win: 10, draw: 5, loss: 0, bonus: 2 }
  pointsDistribution String             // JSON string: { first: 25, second: 15, third: 10, fourth: 5 }
  status             String             @default("ACTIVE") // ACTIVE, INACTIVE, COMPLETED
  players            PlayerSport[]
  referees           RefereeSport[]
  matches            Match[]
  pointsHistory      PointsHistory[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Player {
  id                String             @id @default(uuid())
  registrationId    String             @unique
  name              String
  email             String
  phone             String?
  gender            String?
  age               Int?
  clubId            String
  club              Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teamName          String?
  registrationDate  DateTime           @default(now())
  status            String             @default("APPROVED") // APPROVED, PENDING, REJECTED
  paymentStatus     String             @default("PAID")     // PAID, PENDING, WAIVED
  sports            PlayerSport[]
  matchParticipants MatchParticipant[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PlayerSport {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([playerId, sportId])
}

model Referee {
  id           String         @id @default(uuid())
  refereeCode  String         @unique
  name         String
  email        String         @unique
  phone        String?
  availability String         @default("AVAILABLE") // AVAILABLE, BUSY, UNAVAILABLE
  status       String         @default("ACTIVE")    // ACTIVE, INACTIVE
  sports       RefereeSport[]
  matches      MatchReferee[]
  results      MatchResult[]
  user         User?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RefereeSport {
  id        String   @id @default(uuid())
  refereeId String
  referee   Referee  @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([refereeId, sportId])
}

model Venue {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String
  capacity  Int?
  status    String   @default("ACTIVE")
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Match {
  id            String             @id @default(uuid())
  matchCode     String             @unique
  sportId       String
  sport         Sport              @relation(fields: [sportId], references: [id], onDelete: Cascade)
  round         String             // e.g. "Round 1", "Quarterfinal", "Semifinal", "Final", "League Match 1"
  stageName     String?            // "Group A", "Finals", etc.
  matchDate     String             // YYYY-MM-DD (e.g. 2026-11-25)
  matchTime     String             // HH:mm (e.g. 10:00)
  venueId       String?
  venue         Venue?             @relation(fields: [venueId], references: [id])
  status        String             @default("SCHEDULED") // SCHEDULED, UPCOMING, IN_PROGRESS, AWAITING_RESULT, SUBMITTED, COMPLETED, CANCELLED, DISPUTED
  notes         String?
  participants  MatchParticipant[]
  referees      MatchReferee[]
  results       MatchResult[]
  scoreEntries  ScoreEntry[]
  pointsHistory PointsHistory[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model MatchParticipant {
  id           String       @id @default(uuid())
  matchId      String
  match        Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  clubId       String?
  club         Club?        @relation(fields: [clubId], references: [id])
  playerId     String?
  player       Player?      @relation(fields: [playerId], references: [id])
  teamName     String?
  score        Int          @default(0)
  scoreDetail  String?      // JSON string: e.g. sets, overs, goals, etc.
  isWinner     Boolean      @default(false)
  rank         Int?
  scoreEntries ScoreEntry[]
}

model MatchReferee {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  refereeId String
  referee   Referee  @relation(fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([matchId, refereeId])
}

model MatchResult {
  id                    String    @id @default(uuid())
  matchId               String
  match                 Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedByRefereeId  String
  referee               Referee   @relation(fields: [submittedByRefereeId], references: [id])
  submittedAt           DateTime  @default(now())
  winnerParticipantId   String?
  winnerClubId          String?
  scoresSummary         String    // e.g. "Apex Predators (3) - Titan Warriors (1)"
  refereeNotes          String?
  status                String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, CORRECTED
  approvedByUserId      String?
  approvedAt            DateTime?
  disputeReason         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ScoreEntry {
  id            String           @id @default(uuid())
  matchId       String
  match         Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participantId String
  participant   MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  setOrHalf     String           // "Set 1", "Half 1", "Round 1"
  scoreValue    Int              @default(0)
  details       String?          // JSON metadata
  createdAt     DateTime         @default(now())
}

model PointsHistory {
  id             String   @id @default(uuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sportId        String
  sport          Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  matchId        String?
  match          Match?   @relation(fields: [matchId], references: [id])
  points         Int
  reason         String   // "Win in Quarterfinal", "Draw", "Tournament Gold Medal"
  recordedAt     DateTime @default(now())
  recordedByUserId String?
}

model LeaderboardEntry {
  id              String   @id @default(uuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sportId         String   @default("OVERALL") // "OVERALL" represents overall club leaderboard, or specific sportId
  rank            Int      @default(1)
  played          Int      @default(0)
  won             Int      @default(0)
  drawn           Int      @default(0)
  lost            Int      @default(0)
  points          Int      @default(0)
  scoreDifference Int      @default(0)
  gold            Int      @default(0)
  silver          Int      @default(0)
  bronze          Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([clubId, sportId])
}

model Registration {
  id             String   @id @default(uuid())
  submissionId   String   @unique
  fullName       String
  email          String
  phone          String?
  gender         String?
  age            Int?
  clubPreference String
  sportsSelected String   // Comma separated or JSON string of sports
  teamName       String?
  rawData        String?  // JSON of original submission
  source         String   @default("GOOGLE_SHEETS") // GOOGLE_SHEETS, CSV_IMPORT, MANUAL
  status         String   @default("PENDING")       // PENDING, APPROVED, REJECTED, DUPLICATE
  duplicateOfId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GoogleIntegration {
  id                   String              @id @default(uuid())
  sheetId              String              @unique
  sheetName            String              @default("Sheet1")
  range                String              @default("A1:Z500")
  apiKeyOrToken        String?
  fieldMapping         String              // JSON string of mappings e.g. { "Full Name": "fullName", "Email": "email" }
  autoSyncEnabled      Boolean             @default(false)
  syncIntervalMinutes  Int                 @default(15)
  lastSyncAt           DateTime?
  status               String              @default("CONFIGURED") // CONFIGURED, SYNCING, ERROR, DISABLED
  errorMessage         String?
  syncLogs             SynchronizationLog[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model SynchronizationLog {
  id             String             @id @default(uuid())
  integrationId  String?
  integration    GoogleIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  syncType       String             // GOOGLE_SHEETS, CSV_IMPORT, MANUAL
  totalFound     Int                @default(0)
  importedCount  Int                @default(0)
  duplicateCount Int                @default(0)
  failedCount    Int                @default(0)
  status         String             // SUCCESS, WARNING, FAILED
  logDetails     String?            // JSON string with detailed message / breakdown
  createdAt      DateTime           @default(now())
}

model Notification {
  id            String   @id @default(uuid())
  recipientRole String?  // "ADMIN", "REFEREE", or specific role
  recipientUserId String?
  title         String
  message       String
  type          String   // REGISTRATION, RESULT_SUBMITTED, DISPUTE, ASSIGNMENT, SYSTEM
  isRead        Boolean  @default(false)
  link          String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  userName      String?
  role          String?
  action        String   // CREATE_MATCH, SUBMIT_RESULT, APPROVE_RESULT, UPDATE_POINTS, etc.
  entity        String   // Match, Result, Club, Player, etc.
  recordId      String?
  previousValue String?  // JSON string
  updatedValue  String?  // JSON string
  ipAddress     String?
  timestamp     DateTime @default(now())
}

model TournamentSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
