{
  "name": "@club-portal/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Club Portal REST API (Node.js, Express, MongoDB)",
  "scripts": {
    "generate": "node scripts/generate-routes.mjs",
    "dev": "npm run generate && tsx watch --clear-screen=false src/server.ts",
    "build": "npm run generate && tsup",
    "start": "node dist/server.js",
    "typecheck": "npm run generate && tsc --noEmit",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:mongo": "node scripts/seed-mongo.js",
    "seed:roster": "node scripts/seed-roster.js",
    "seed:players": "node scripts/seed-players.js",
    "seed:matches": "node scripts/seed-matches.js",
    "seed:scoring-rules": "tsx scripts/seed-scoring-rules.ts"
  },
  "dependencies": {
    "@club-portal/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.19",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
